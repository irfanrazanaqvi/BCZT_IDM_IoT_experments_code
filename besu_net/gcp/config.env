# Edit PROJECT, then source this file from the other scripts (they do it for you).
export PROJECT="YOUR_GCP_PROJECT_ID"
export MACHINE="e2-standard-2"                       # 2 vCPU, 8 GB
export IMAGE_FAMILY="ubuntu-2404-lts-amd64"          # Ubuntu 24.04 ships OpenJDK 21 (Besu 25.x needs Java 21)
export IMAGE_PROJECT="ubuntu-os-cloud"
export BESU_VERSION="25.7.0"
# Node i runs in ZONES[i]; the load generator runs in LOADGEN_ZONE.
export ZONES=("europe-west3-b" "us-east4-b" "asia-southeast1-b" "southamerica-east1-b")
export LOADGEN_ZONE="europe-west3-b"
export NODE_NAMES=("besu-n0" "besu-n1" "besu-n2" "besu-n3")
export LOADGEN_NAME="besu-loadgen"
export REPO_URL="https://github.com/irfanrazanaqvi/BCZT_IDM_IoT_experments_code"
